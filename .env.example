# Firebase client (public : visible dans le navigateur, c'est normal).
# À copier depuis la console Firebase → Paramètres du projet → Vos applications.
# Ce sont tes règles Firestore qui protègent les données, pas le secret de ces clés.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (serveur uniquement). Ne jamais préfixer par NEXT_PUBLIC_.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Garder les \n littéraux dans la clé, entre guillemets
FIREBASE_ADMIN_PRIVATE_KEY=

# Formulaire d'avis (envoi d'e-mail)
GMAIL_USER=
GMAIL_APP_PASSWORD=
FEEDBACK_TO=

# App Check : laisser absent ou false tant que le client n'envoie pas X-Firebase-AppCheck
APPCHECK_ENFORCE=false
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Adresse publique du site (liens de vérification des attestations)
NEXT_PUBLIC_SITE_URL=https://maucode-web.vercel.app

# Développement local seulement (ignoré en production) : ne JAMAIS définir sur Vercel
# ATTESTATION_DEV_BYPASS=1